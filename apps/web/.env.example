DATABASE_URL="postgresql://user:password@localhost:5432/paragliding_logbook?schema=public"

# Secret Better Auth (signature des sessions/cookies) : générer une valeur
# aléatoire par environnement (ex. `openssl rand -base64 32`), jamais partagée.
BETTER_AUTH_SECRET="change-me-locally"

# Optionnel en local (Better Auth déduit l'origine de la requête). À définir
# explicitement en production/preview (Vercel) : Better Auth lit cette
# variable automatiquement sans configuration supplémentaire dans lib/auth.ts.
# BETTER_AUTH_URL="https://thermik.example.com"

# Compte admin créé par `pnpm prisma:seed` (prisma/seed.ts) : seul moyen
# d'obtenir un compte ADMIN, /sign-up n'attribue jamais ce rôle (voir
# docs/admin.md). Sans ADMIN_PASSWORD, le seed passe la création du compte
# admin (comportement volontaire en production, voir docs/todo.md).
# ADMIN_EMAIL="admin@thermik.com"
# ADMIN_PASSWORD="change-me-locally"
