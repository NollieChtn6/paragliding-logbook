DATABASE_URL="postgresql://user:password@localhost:5432/paragliding_logbook?schema=public"

# Mot de passe du compte de développement créé par prisma/seed.ts (jamais en dur
# dans le code, voir CLAUDE.md > Authentification).
DEV_USER_PASSWORD="change-me-locally"

# Secret Better Auth (signature des sessions/cookies) : générer une valeur
# aléatoire par environnement (ex. `openssl rand -base64 32`), jamais partagée.
BETTER_AUTH_SECRET="change-me-locally"
